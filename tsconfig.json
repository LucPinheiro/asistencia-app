{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,

    // Expo usa "customConditions" en su base; para que no dé error:
    "moduleResolution": "bundler",

    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    // Quita "jest" si no tienes @types/jest instalado
    "types": ["react", "react-native"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
